EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_or_anon_key

# Native Google Maps (Android APK). Boşsa OSM WebView kullanılır.
# 1) https://console.cloud.google.com → proje oluştur
# 2) APIs & Services → Enable → "Maps SDK for Android"
# 3) Credentials → Create API key → Application restrictions: Android apps
#    Package: com.rezkort.app
#    SHA-1 (local debug/release keystore): 5E:8F:16:06:2E:A3:CD:2C:4A:0D:54:78:76:BA:A6:F3:8C:AB:F6:25
# 4) Anahtarı aşağıya yapıştır → APK yeniden derle (prebuild/run:android)
# Ücretsiz: Google Maps Platform aylık $200 kredi (küçük kullanımda genelde 0 TL)
# GOOGLE_MAPS_API_KEY=AIza...
